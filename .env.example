# Copy to .env and fill in. .env is gitignored; never commit it.

# Where the hosted SenseLab API lives, and the key for it.
# Create keys in the dashboard under Settings -> API Keys.
AMFS_HTTP_URL=https://amfs-login.sense-lab.ai
AMFS_API_KEY=

# Examples 05 and 07: a second key, created by a DIFFERENT user. The user can
# be in your account (added on the Teams page) or in another one. Two keys
# created by the same user already share memory and do not need a room.
AMFS_API_KEY_B=

# Example 07, optional: one reader user per case, comma-separated, in the
# order of CASES in poc/cases.py. When set, example 07 ignores AMFS_API_KEY_B.
# AMFS_API_KEYS_B_PER_CASE=

# The LLM that plays the agents in examples 01, 03, 04 and 07. One of the two
# is enough. Example 07 runs without one with --memory-only.
# Example 06 (Claude Code) needs ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional. Defaults to claude-sonnet-5-5 with Anthropic.
# Required when you use OPENAI_API_KEY: there is no default OpenAI model.
# POC_MODEL=
